// Code signing for every target.
// Builds are ad-hoc signed ("Sign to Run Locally"): no certificate, no Apple
// account, nothing Apple can revoke. The root helper and the app only trust
// each other's exact build (see HelperInterface.requirement(for:)).
// To sign with your own certificate instead, override these in
// Local.xcconfig, which git ignores (see Local.xcconfig.example).
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
